APP_ENV=production
DEBUG=false
DEBUG_RESET_ENABLED=false
REGISTRATION_ENABLED=false
CAREERPASS_DOMAIN=careerpass.example.com

POSTGRES_USER=careerpass
POSTGRES_PASSWORD=replace-with-production-password
POSTGRES_DB=careerpass
DATABASE_URL=postgresql+asyncpg://careerpass:replace-with-production-password@postgres:5432/careerpass
REDIS_URL=redis://redis:6379/0
DATABASE_POOL_SIZE=2
JWT_SECRET_KEY=replace-with-at-least-32-characters

DEMO_CANDIDATE_USERNAME=candidate_prod
DEMO_CANDIDATE_PASSWORD=replace-with-production-password
DEMO_HR_USERNAME=hr_prod
DEMO_HR_PASSWORD=replace-with-production-password

MINERU_API_KEY=replace-with-mineru-key
DASHSCOPE_API_KEY=replace-with-dashscope-key
# Optional when the Worker must use a host-reachable proxy.
# CAREERPASS_CONTAINER_PROXY=http://host.docker.internal:7897
# CAREERPASS_CONTAINER_NO_PROXY=localhost,127.0.0.1,postgres,redis
