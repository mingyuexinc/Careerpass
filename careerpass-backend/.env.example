# 仅提供非敏感示例；真实 .env 不得提交。
APP_NAME=CareerPass API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# 使用 PostgreSQL 16；真实凭据只能写入未提交的 .env 或部署密钥存储。
DATABASE_URL=postgresql+asyncpg://careerpass:change-me@localhost:5432/careerpass
REDIS_URL=redis://localhost:6379/0
READINESS_TIMEOUT_SECONDS=2
CELERY_TASK_TIME_LIMIT_SECONDS=30
